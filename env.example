# LOCAL WINDOWS (optional - run-app.bat configures this automatically)
# DATA_DIR=C:\Users\YOUR_USER\AppData\Local\ObourYouthClub\data

# RAILWAY / OTHER HOST WITH A PERSISTENT DISK
# Mount a persistent volume at /data, then set:
# DATA_DIR=/data
# BACKUP_DIR=/data/backups

# Change these in production:
# ADMIN_USER=your-admin
# ADMIN_PASS=your-strong-password
